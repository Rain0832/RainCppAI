{
  "server": {
    "port": 80,
    "threads": 4
  },
  "db": {
    "host": "127.0.0.1",
    "port": 3307,
    "user": "chat",
    "password": "",
    "name": "ChatHttpServer",
    "pool_size": 5
  },
  "paths": {
    "resource_root": "../",
    "mcp_config": "../mcp_config.json",
    "models_config": "../models.json"
  },
  "mcp": {
    "python": "/root/RainCppAI/.venv/bin/python"
  },
  "ai": {
    "thread_pool_size": 8,
    "max_tool_rounds": 5,
    "max_sessions": 500
  },
  "cors": {
    "allowed_origins": [
      "http://localhost:8080",
      "http://127.0.0.1:8080"
    ],
    "allow_credentials": true
  },
  "security": {
    "hsts_enabled": true,
    "x_frame_options": "DENY"
  },
  "mail": {
    "host": "smtp.qq.com",
    "port": 465,
    "username": "",
    "password": ""
  },
  "default_api_keys": {
    "dashscope": "sk-your-dashscope-key",
    "doubao": "your-doubao-key"
  },
  "jwt": {
    "secret": "change-this-to-a-random-secret"
  },
  "log": {
    "level": "info",
    "path": "logs/app.log"
  },
  "redis": {
    "host": "127.0.0.1",
    "port": 6379,
    "password": "",
    "db": 0
  },
  "rabbitmq": {
    "uri": "",
    "vision_queue": "vision_tasks",
    "tts_queue": "tts_tasks"
  }
}
